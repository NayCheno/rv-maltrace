      "legacy": false,
      "tier": "current-gate",
      "checks": [
        {
          "id": "board-baseline",
          "label": "Genesys2/CVA6 board baseline evidence",
          "command": ["{python}", "tools/check_board_baseline.py", "--root", "{root}"],
          "tags": ["genesys2", "cva6", "board", "baseline"]
        },
        {
          "id": "board-trace-minimal",
          "label": "Genesys2/CVA6 minimal trace policy",
          "command": ["{python}", "tools/check_board_trace_minimal.py", "--root", "{root}"],
          "tags": ["genesys2", "cva6", "trace", "policy"]
        },
        {
          "id": "board-trace-programs",
          "label": "Genesys2/CVA6 board trace validation program plan",
          "command": ["{python}", "tools/check_board_trace_programs.py", "--root", "{root}"],
          "tags": ["genesys2", "cva6", "trace", "programs"]
        },
        {
          "id": "board-trace-evidence",
          "label": "Genesys2/CVA6 board trace validation evidence",
          "command": ["{python}", "tools/check_board_trace_evidence.py", "--root", "{root}"],
          "tags": ["genesys2", "cva6", "trace", "evidence"]
        },
        {
          "id": "board-local-code-analysis",
          "label": "Genesys2/CVA6 board local code analysis evidence",
