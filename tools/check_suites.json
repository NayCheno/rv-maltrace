{
  "schema": "rvmt.check_suites.v1",
  "suites": [
    {
      "id": "genesys2-current",
      "title": "Current Digilent Genesys2 + CVA6 gate",
      "description": "Active repository gate for the current hardware route. This suite intentionally excludes legacy 35T checks.",
