          "tags": ["genesys2", "cva6", "safe-surrogate", "claim-boundary"]
        },
        {
          "id": "safe-surrogate-manifest-coverage",
          "label": "Genesys2/CVA6 safe surrogate full manifest coverage",
          "command": ["{python}", "tools/check_genesys2_safe_surrogate_coverage.py", "--root", "{root}"],
          "tags": ["genesys2", "cva6", "safe-surrogate", "manifest-coverage", "claim-boundary"]
