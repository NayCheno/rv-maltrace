title: "RV-MalTrace: RISC-V 硬件辅助恶意软件行为追踪"
size: [1280, 720]
theme:
  colors:
    primary: "#1E3A5F"
    secondary: "#5B6B82"
    accent: "#B45309"
    background: "#F7F8FA"
    text: "#1A1D23"
    surface: "#FFFFFF"
    lightbg: "#EFF1F5"
  textStyles:
    title:
      fontSize: 40
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
      letterSpacing: 2
    subtitle:
      fontSize: 22
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.4
    heading:
      fontSize: 28
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.3
    body:
      fontSize: 18
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.6
    caption:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.4
    nav:
      fontSize: 14
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
  tableStyles:
    default:
      fontSize: 16
      fontFamily: "QuattrocentoSans, MiSans"
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill:
        - "#FFFFFF"
        - "#EFF1F5"
      bodyColor: "$text"
      border:
        style: solid
        width: 1
        color: "#E2E5EA"
pages:
  - pages/cover.page
  - pages/toc.page
  - pages/ch1.page
  - pages/problem.page
  - pages/motivation.page
  - pages/ch2.page
  - pages/tech_difficulties.page
  - pages/implementation_challenges.page
  - pages/ch3.page
  - pages/solution.page
  - pages/strategy.page
  - pages/ch4.page
  - pages/background.page
  - pages/hardware_arch.page
  - pages/semantic_pipeline.page
  - pages/evaluation.page
  - pages/boundaries.page
  - pages/final.page