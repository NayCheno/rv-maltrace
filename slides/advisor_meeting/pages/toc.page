pageType: table_of_contents
background:
  type: solid
  color: "$background"
elements:
  - elementId: toc-label
    elementType: text
    bounds: [60, 80, 400, 50]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      letterSpacing: 4
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>CONTENTS</strong></p>
  - elementId: toc-title
    elementType: text
    bounds: [60, 130, 400, 60]
    content:
      style: "$heading"
      fontSize: 36
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>汇报提纲</strong></p>
  - elementId: toc-accent-line
    elementType: shape
    bounds: [60, 200, 80, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: toc-item1-num
    elementType: text
    bounds: [60, 260, 80, 50]
    content:
      fontSize: 32
      color: "$accent"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>01</strong></p>
  - elementId: toc-item1-title
