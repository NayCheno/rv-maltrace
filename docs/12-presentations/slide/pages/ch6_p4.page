pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: nav-text
    elementType: text
    bounds: [60, 0, 400, 40]
    content:
      fontSize: 14
      color: "$white"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p>06 必要的技术背景知识</p>
  - elementId: page-title
    elementType: text
    bounds: [60, 55, 900, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>数据溯源标签规则</strong></p>
  - elementId: intro
    elementType: text
    bounds: [60, 110, 1160, 40]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      text: |
        <p>这是整个系统防止 过度声称 的核心机制：</p>
  - elementId: label-table
    elementType: table
    bounds: [60, 160, 1160, 250]
    columnWidths: [0.2, 0.4, 0.2, 0.2]
    rowHeights: [0.15, 0.2, 0.2, 0.2, 0.25]
    style: "$default"
    rows:
      - - content: {text: "标签"}
        - content: {text: "来源"}
        - content: {text: "用途"}
        - content: {text: "能否 Claim"}
      - - content: {text: "hardware"}
        - content: {text: "板级 trace"}
        - content: {text: "支撑 claim"}
        - content:
            text: |
              <p><span style="color:#10B981;"><strong>✅</strong></span></p>
      - - content: {text: "exact_elf"}
        - content: {text: "目标 ELF 静态分析"}
        - content: {text: "支撑 claim"}
        - content:
            text: |
              <p><span style="color:#10B981;"><strong>✅</strong></span></p>
      - - content: {text: "runtime_os_map"}
        - content: {text: "运行时进程映射"}
        - content: {text: "支撑 claim"}
        - content:
            text: |
              <p><span style="color:#10B981;"><strong>✅</strong></span></p>
      - - content: {text: "validation_oracle"}
        - content: {text: "qemu/strace/host"}
        - content: {text: "只验证，不 claim"}
        - content:
            text: |
              <p><span style="color:#EF4444;"><strong>❌</strong></span></p>
  - elementId: checker-note-bg
    elementType: shape
    bounds: [60, 430, 1160, 80]
    shapeName: roundRect
    adjustments: [6000]
    fill:
      type: solid
      color: "#FEF3C7"
  - elementId: checker-note-text
    elementType: text
    bounds: [80, 440, 1120, 60]
    content:
      fontSize: 14
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.5
      align: [left, middle]
      text: |
        <p><strong>Checker 规则</strong>：验证基准值 field 不能被标为 hardware-only。checker 会检查每个字段的标签是否合法，拒绝任何不合法的组合。</p>
  - elementId: footer
    elementType: text
    bounds: [60, 680, 400, 30]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>RV-MalTrace 深度技术汇报</p>
  - elementId: page-num
    elementType: text
    bounds: [1180, 680, 60, 30]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>31</p>
